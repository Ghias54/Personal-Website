---
import BaseLayout from "../layouts/BaseLayout.astro";
import IssuerLogo from "../components/IssuerLogo.astro";

interface CertEntry {
  name: string;
  issuer: string;
  date: string;
  credentialUrl: string;
}

interface CertGroup {
  name: string;
  color: string;
  items: CertEntry[];
}

const groups: CertGroup[] = [
  {
    name: "Data & Analytics",
    color: "#1F2A36",
    items: [
      {
        name: "Extract, Transform and Load Data in Power BI",
        issuer: "Microsoft",
        date: "Feb 2026",
        credentialUrl: "https://coursera.org/share/79546c1e8f0de09844c77bb2bff73f3a",
      },
      {
        name: "Harnessing the Power of Data with Power BI",
        issuer: "Microsoft",
        date: "July 2025",
        credentialUrl: "https://coursera.org/share/ebecc79313353debd13fdb2028670e23",
      },
      {
        name: "Preparing Data for Analysis with Microsoft Excel",
        issuer: "Microsoft",
        date: "May 2025",
        credentialUrl: "https://coursera.org/share/0a5460d67af9a3e77535ab96754fd293",
      },
    ],
  },
  {
    name: "Artificial Intelligence",
    color: "#5C7186",
    items: [
      {
        name: "Google Prompting Essentials Specialization",
        issuer: "Google",
        date: "Aug 2025",
        credentialUrl: "https://coursera.org/share/ada2680658bde44de8948fa1d038bb90",
      },
      {
        name: "Google AI Essentials Specialization",
        issuer: "Google",
        date: "Jun 2025",
        credentialUrl: "https://coursera.org/share/f35e8cb86431e1a48a9c9f3be2a09ef7",
      },
    ],
  },
  {
    name: "Programming & Other",
    color: "#8494A4",
    items: [
      {
        name: "C++ Proficiency Certificate",
        issuer: "College of DuPage",
        date: "May 2026",
        credentialUrl: "",
      },
      {
        name: "Web3 and Blockchain Fundamentals",
        issuer: "INSEAD",
        date: "Dec 2025",
        credentialUrl: "https://coursera.org/share/fd53fe8d6cd438f156b2b9946fa5755b",
      },
    ],
  },
];

function groupId(name: string) {
  return `group-${name.replace(/\W+/g, "-").toLowerCase()}`;
}
---

<BaseLayout
  title="Certifications — Rehan Ghias"
  description="Certifications and coursework in data analytics, AI, and programming."
  bandTitle="Certifications"
>
  <main id="main-content" class="container page">
    <div class="groups">
      {
        groups.map((group) => (
          <section class="cert-group" aria-labelledby={groupId(group.name)}>
            <div class="group-header">
              <span
                class="group-swatch"
                style={`background:${group.color}`}
                aria-hidden="true"
              />
              <h2
                id={groupId(group.name)}
                class="group-title"
                style={`color:${group.color}`}
              >
                {group.name}
              </h2>
              <span class="group-rule" aria-hidden="true" />
              <span class="group-count meta">{group.items.length}</span>
            </div>

            <ul class="cert-list">
              {group.items.map((cert) => {
                const titleHref = cert.credentialUrl.trim();
                const meta = `${cert.issuer} · ${cert.date}`;

                return (
                  <li class="cert-item">
                    <div class="cert-row">
                      <IssuerLogo issuer={cert.issuer} />
                      <span class="cert-text">
                        <span class="cert-name">
                          {titleHref ? (
                            <a
                              href={titleHref}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              {cert.name}
                            </a>
                          ) : (
                            cert.name
                          )}
                        </span>
                        <span class="cert-meta">{meta}</span>
                      </span>
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  .groups {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .group-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 0;
  }

  .group-swatch {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .group-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }

  .group-rule {
    flex: 1;
    height: 0;
    border-top: 1px solid var(--color-border);
    min-width: 16px;
  }

  .group-count {
    flex-shrink: 0;
    color: var(--color-muted);
  }

  .cert-list {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .cert-item + .cert-item {
    border-top: 1px solid var(--color-border);
  }

  .cert-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 0;
  }

  .cert-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    flex: 1;
  }

  .cert-name {
    font-family: var(--font-sans);
    font-size: var(--fs-heading);
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-heading);
  }

  .cert-name a {
    color: var(--color-dark);
    text-decoration: underline;
    text-decoration-color: var(--color-link-underline);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .cert-name a:hover {
    text-decoration-color: var(--color-dark);
  }

  .cert-meta {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-label);
    line-height: 1.4;
  }
</style>
