---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkListItem from "../../components/WorkListItem.astro";
import * as home from "../../content/home.md";

const { cards } = home.frontmatter;
---

<BaseLayout
  title="Projects — Rehan Ghias"
  description="Selected work: operational analysis at Truly Engaging and a quantitative earnings research pipeline."
  bandTitle="Projects"
>
  <main class="container page">
    <section class="work-block" aria-labelledby="work-heading">
      <hr class="rule-strong work-rule" />
      <p id="work-heading" class="work-label">Work</p>
      <ul class="work-list">
        {
          cards.map((card) => (
            <WorkListItem
              eyebrow={card.eyebrow}
              title={card.title}
              summary={card.summary}
              href={card.href}
            />
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .work-rule {
    margin: 0;
  }

  .work-label {
    margin: 14px 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    line-height: 1.4;
  }

  .work-list {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }
</style>
