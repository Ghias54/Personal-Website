---
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import * as home from "../content/home.md";

const { title, tagline, description, email, github, cards } = home.frontmatter;
const heroHtml = await home.compiledContent();
---

<BaseLayout title={`${title} — Data & Operations Analysis`} description={description}>
  <main class="container page home">
    <header class="hero">
      <h1>{title}</h1>
      <p class="meta tagline">{tagline}</p>
      <div class="prose hero-copy" set:html={heroHtml} />
      <nav class="links meta" aria-label="Contact and links">
        <a href={`mailto:${email}`}>Email</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/resume">Resume</a>
      </nav>
    </header>

    <hr class="hairline" />

    <section class="selected-work" id="selected-work" aria-labelledby="selected-work-heading">
      <h2 id="selected-work-heading" class="meta section-label">Selected work</h2>
      <ul class="card-grid">
        {
          cards.map((card) => (
            <CaseStudyCard
              eyebrow={card.eyebrow}
              title={card.title}
              summary={card.summary}
              href={card.href}
            />
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    margin-bottom: 40px;
  }

  .hero h1 {
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .tagline {
    margin: 10px 0 0;
  }

  .hero-copy {
    margin-top: 48px;
    margin-bottom: 28px;
  }

  .hero-copy :global(p + p) {
    margin-top: 20px;
  }

  .hero-copy :global(p:first-child) {
    font-size: 18px;
  }

  .hero-copy :global(p:last-child) {
    margin-top: 32px;
    margin-bottom: 32px;
    padding-left: 16px;
    border-left: 2px solid var(--color-heading);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em 0.5em;
    align-items: center;
  }

  .links a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .links a {
    color: var(--color-accent);
  }

  .links a:hover {
    color: var(--color-accent-deep);
  }

  .sep {
    color: var(--color-muted);
  }

  .selected-work {
    margin-top: 40px;
  }

  .section-label {
    margin: 0 0 20px;
  }
</style>
