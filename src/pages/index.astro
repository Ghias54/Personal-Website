---
import BaseLayout from "../layouts/BaseLayout.astro";
import * as home from "../content/home.md";

const { title, tagline, description, email, github, cards } = home.frontmatter;
const heroHtml = await home.compiledContent();
---

<BaseLayout title={`${title} — Data & Operations Analysis`} description={description}>
  <main class="page home">
    <header class="hero">
      <h1>{title}</h1>
      <p class="meta tagline">{tagline}</p>
      <div class="prose hero-copy" set:html={heroHtml} />
      <nav class="links meta" aria-label="Contact and links">
        <a href={`mailto:${email}`}>Email</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/resume">Resume</a>
      </nav>
    </header>

    <hr class="hairline" />

    <section class="selected-work" id="selected-work" aria-labelledby="selected-work-heading">
      <h2 id="selected-work-heading" class="meta section-label">Selected work</h2>
      <ul class="card-grid">
        {
          cards.map((card) => (
            <li>
              <a class="card" href={card.href}>
                <div class="card-body">
                  <p class="meta card-eyebrow">{card.eyebrow}</p>
                  <h3 class="card-title">{card.title}</h3>
                  <p class="card-summary">{card.summary}</p>
                </div>
                <span class="meta card-cta">Read the case study →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    margin-bottom: 40px;
  }

  .hero h1 {
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .tagline {
    margin: 10px 0 0;
  }

  .hero-copy {
    margin-top: 48px;
    margin-bottom: 28px;
  }

  .hero-copy :global(p + p) {
    margin-top: 20px;
  }

  .hero-copy :global(p:first-child) {
    font-size: 18px;
  }

  .hero-copy :global(p:last-child) {
    margin-top: 32px;
    margin-bottom: 32px;
    padding-left: 16px;
    border-left: 2px solid var(--color-heading);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em 0.5em;
    align-items: center;
  }

  .links a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .links a:hover {
    color: var(--color-heading);
  }

  .sep {
    color: var(--color-muted);
  }

  .selected-work {
    margin-top: 40px;
    scroll-margin-top: 72px;
  }

  .section-label {
    margin: 0 0 20px;
  }

  .card-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .card-grid > li {
    display: flex;
    min-height: 100%;
  }

  .card {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100%;
    padding: 22px 20px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .card:hover {
    border-color: rgba(0, 0, 0, 0.28);
    transform: translateY(-1px);
  }

  .card:hover .card-cta {
    color: var(--color-heading);
  }

  .card-body {
    flex: 1;
  }

  .card-eyebrow {
    margin: 0 0 10px;
  }

  .card-title {
    margin: 0 0 12px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--color-heading);
  }

  .card-summary {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-text);
  }

  .card-cta {
    display: block;
    margin-top: 24px;
  }

  @media (max-width: 700px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
