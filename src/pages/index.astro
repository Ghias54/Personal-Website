---
import BaseLayout from "../layouts/BaseLayout.astro";
import RailSection from "../components/RailSection.astro";
import WorkListItem from "../components/WorkListItem.astro";
import * as home from "../content/home.md";

const { description, email, github, cards } = home.frontmatter;
const heroHtml = await home.compiledContent();
const paragraphs = heroHtml.match(/<p>[\s\S]*?<\/p>/g) ?? [];
const aboutHtml = paragraphs.slice(0, 4).join("");
const seekingHtml = paragraphs[4] ?? "";
---

<BaseLayout
  title="Rehan Ghias — Information Science & Economics"
  description={description}
  homeBand
>
  <main class="container page home">
    <RailSection label="About">
      <div class="about-copy prose" set:html={aboutHtml} />
    </RailSection>

    <RailSection label="Seeking">
      <div class="seeking-copy" set:html={seekingHtml} />
    </RailSection>

    <RailSection label="Contact">
      <nav class="contact-links" aria-label="Contact and links">
        <a href={`mailto:${email}`}>Email</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/resume">Resume</a>
      </nav>
    </RailSection>

    <section class="work-block" id="selected-work" aria-labelledby="work-heading">
      <hr class="rule-strong work-rule" />
      <p id="work-heading" class="work-label">Work</p>
      <ul class="work-list">
        {
          cards.map((card) => (
            <WorkListItem
              eyebrow={card.eyebrow}
              title={card.title}
              summary={card.summary}
              href={card.href}
            />
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .about-copy :global(p:first-child) {
    font-size: 17px;
    color: var(--color-text);
  }

  .about-copy :global(p) {
    font-size: 16px;
    color: var(--color-dimmed);
  }

  .about-copy :global(p + p) {
    margin-top: 1.15em;
  }

  .seeking-copy :global(p) {
    margin: 0;
    max-width: var(--measure);
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-text);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 0;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .contact-links a {
    color: var(--color-dark);
    text-decoration: underline;
    text-decoration-color: var(--color-link-underline);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    background: transparent;
  }

  .contact-links a:hover {
    text-decoration-color: var(--color-dark);
  }

  .sep {
    margin: 0 20px;
    color: var(--color-muted);
    text-decoration: none;
  }

  .work-block {
    margin-top: 56px;
  }

  .work-rule {
    margin: 0;
  }

  .work-label {
    margin: 14px 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    line-height: 1.4;
  }

  .work-list {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }
</style>
