---
interface Props {
  index: number;
  eyebrow: string;
  title: string;
  summary: string;
  href: string;
}

const { index, eyebrow, title, summary, href } = Astro.props;
const number = String(index).padStart(2, "0");
---

<li class="work-item">
  <a class="work-link" href={href}>
    <div class="work-rail">
      <span class="work-rail-num">{number} /</span>
      <span class="work-rail-eyebrow">{eyebrow}</span>
    </div>
    <div class="work-body">
      <h3 class="work-title">{title}</h3>
      <p class="work-summary">{summary}</p>
    </div>
  </a>
</li>

<style>
  .work-item + .work-item {
    border-top: 1px solid var(--color-border);
  }

  .work-link {
    display: grid;
    grid-template-columns: var(--rail-width) minmax(0, 1fr);
    gap: var(--rail-gap);
    align-items: start;
    padding: 24px 0 22px;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.15s ease;
  }

  .work-link:hover {
    background: var(--color-surface);
    text-decoration: none;
  }

  .work-link:hover .work-title {
    color: var(--color-dark);
  }

  .work-rail {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-muted);
    line-height: 1.4;
  }

  .work-title {
    margin: 0 0 10px;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--color-heading);
  }

  .work-summary {
    margin: 0;
    max-width: var(--measure);
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-dimmed);
  }

  @media (max-width: 700px) {
    .work-link {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
