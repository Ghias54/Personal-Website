---
interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  href: string;
  /** Heading level for the title. Use 2 on pages where there is no parent section h2. */
  headingLevel?: 2 | 3;
}

const { eyebrow, title, summary, href, headingLevel = 3 } = Astro.props;
const TitleTag = headingLevel === 2 ? "h2" : "h3";
---

<li class="work-entry">
  <a class="work-entry-link" href={href}>
    <p class="eyebrow">{eyebrow}</p>
    <TitleTag class="title">{title}</TitleTag>
    <p class="summary">{summary}</p>
    <span class="read-more" aria-hidden="true">Read case study →</span>
  </a>
</li>

<style>
  .work-entry {
    display: flex;
  }

  .work-entry-link {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 28px 28px 24px;
    text-decoration: none;
    color: inherit;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-dark);
    border-radius: var(--radius);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .work-entry-link:hover {
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(31, 42, 54, 0.1);
    border-color: var(--color-link-underline);
    border-top-color: var(--color-dark);
  }

  .eyebrow {
    margin: 0 0 10px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-label);
    line-height: 1.4;
  }

  .title {
    margin: 0 0 10px;
    font-family: var(--font-sans);
    font-size: var(--fs-heading);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--color-heading);
  }

  .summary {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-body);
    line-height: 1.6;
    color: var(--color-dimmed);
  }

  .read-more {
    margin-top: auto;
    padding-top: 18px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-entry-link {
      transition: none;
    }
    .work-entry-link:hover {
      transform: none;
    }
  }
</style>
