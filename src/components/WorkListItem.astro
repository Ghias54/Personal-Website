---
interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  href: string;
  /** Heading level for the title. Use 2 on pages where there is no parent section h2. */
  headingLevel?: 2 | 3;
}

const { eyebrow, title, summary, href, headingLevel = 3 } = Astro.props;
const TitleTag = headingLevel === 2 ? "h2" : "h3";
---

<li class="work-entry">
  <a class="work-entry-link" href={href}>
    <p class="eyebrow">{eyebrow}</p>
    <TitleTag class="title">{title}</TitleTag>
    <p class="summary">{summary}</p>
  </a>
</li>

<style>
  .work-entry + .work-entry {
    border-top: 1px solid var(--color-border);
  }

  .work-entry-link {
    display: block;
    width: 100%;
    padding: 24px 0 22px;
    text-decoration: none;
    color: inherit;
    background: transparent;
  }

  .work-entry-link:hover {
    background: transparent;
    text-decoration: none;
  }

  .eyebrow {
    display: block;
    width: 100%;
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-label);
    line-height: 1.4;
  }

  .title {
    display: block;
    width: 100%;
    margin: 0 0 8px;
    font-family: var(--font-sans);
    font-size: var(--fs-heading);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--color-heading);
  }

  .work-entry-link:hover .title {
    color: var(--color-dark);
  }

  .summary {
    display: block;
    width: 100%;
    margin: 0;
    max-width: var(--measure);
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-dimmed);
  }
</style>
