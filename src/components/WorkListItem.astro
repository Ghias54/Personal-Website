---
interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  href: string;
}

const { eyebrow, title, summary, href } = Astro.props;
---

<li class="work-item">
  <a class="work-link" href={href}>
    <p class="work-eyebrow">{eyebrow}</p>
    <h3 class="work-title">{title}</h3>
    <p class="work-summary">{summary}</p>
  </a>
</li>

<style>
  .work-item + .work-item {
    border-top: 1px solid var(--color-border);
  }

  .work-link {
    display: block;
    padding: 24px 0 22px;
    text-decoration: none;
    color: inherit;
    background: transparent;
  }

  .work-link:hover {
    background: transparent;
    text-decoration: none;
  }

  .work-link:hover .work-title {
    color: var(--color-dark);
  }

  .work-eyebrow {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-muted);
    line-height: 1.4;
  }

  .work-title {
    margin: 0 0 10px;
    font-family: var(--font-sans);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--color-heading);
  }

  .work-summary {
    margin: 0;
    max-width: var(--measure);
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-dimmed);
  }
</style>
