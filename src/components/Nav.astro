---
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const links = [
  { href: "/", label: "Profile", active: pathname === "/" },
  {
    href: "/work",
    label: "Projects",
    active: pathname.startsWith("/work"),
  },
  {
    href: "/experience",
    label: "Experience",
    active: pathname.startsWith("/experience"),
  },
  {
    href: "/certifications",
    label: "Certifications",
    active: pathname.startsWith("/certifications"),
  },
  {
    href: "/resume",
    label: "Resume",
    active: pathname.startsWith("/resume"),
  },
] as const;
---

<div class="site-nav">
  <a class="site-nav-mark" href="/" aria-label="Rehan A Ghias — home">RG</a>
  <nav class="site-nav-links" aria-label="Primary">
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={["site-nav-link", { active: link.active }]}
          aria-current={link.active ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</div>

<style>
  .site-nav {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    width: 100%;
    background: transparent;
    border: 0;
  }

  .site-nav-mark {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-on-dark);
    text-decoration: none;
    background: transparent;
  }

  .site-nav-mark:hover {
    color: var(--color-on-dark);
    text-decoration: none;
    background: transparent;
  }

  .site-nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 10px 14px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
    background: transparent;
  }

  .site-nav-link {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-on-dark-muted);
    text-decoration: none;
    background: transparent;
    border: 0;
    padding: 0;
  }

  .site-nav-link:hover {
    color: var(--color-on-dark);
    text-decoration: none;
    background: transparent;
  }

  .site-nav-link.active {
    color: var(--color-on-dark);
  }

  @media (max-width: 700px) {
    .site-nav-links {
      gap: 8px 10px;
    }
  }
</style>
