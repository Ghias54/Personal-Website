---
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const links = [
  { href: "/", label: "Profile", active: pathname === "/" },
  {
    href: "/work",
    label: "Projects",
    active: pathname.startsWith("/work"),
  },
  {
    href: "/certifications",
    label: "Certifications",
    active: pathname.startsWith("/certifications"),
  },
  {
    href: "/resume",
    label: "Resume",
    active: pathname.startsWith("/resume"),
  },
] as const;
---

<div class="site-nav">
  <a class="site-nav-mark" href="/" aria-label="Rehan Ghias — home">RG</a>
  <nav class="site-nav-links" aria-label="Primary">
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={["site-nav-link", { active: link.active }]}
          aria-current={link.active ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</div>

<style>
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 14px 0;
  }

  .site-nav-mark {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-on-dark);
    text-decoration: none;
  }

  .site-nav-mark:hover {
    color: var(--color-on-dark);
    text-decoration: none;
  }

  .site-nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
  }

  .site-nav-link {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-on-dark-muted);
    text-decoration: none;
  }

  .site-nav-link:hover {
    color: var(--color-on-dark);
    text-decoration: none;
  }

  .site-nav-link.active {
    color: var(--color-on-dark);
  }
</style>
