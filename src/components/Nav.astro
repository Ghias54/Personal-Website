---
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const links = [
  { href: "/", label: "Profile", active: pathname === "/" },
  {
    href: "/#selected-work",
    label: "Projects",
    active: pathname.startsWith("/work"),
  },
  {
    href: "/certifications",
    label: "Certifications",
    active: pathname.startsWith("/certifications"),
  },
  {
    href: "/resume",
    label: "Resume",
    active: pathname.startsWith("/resume"),
  },
] as const;
---

<header class="site-nav">
  <div class="site-nav-inner">
    <a class="site-nav-name" href="/">Rehan Ghias</a>
    <nav class="site-nav-links" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={["meta", "site-nav-link", { active: link.active }]}
            aria-current={link.active ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .site-nav-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 20px 24px;
  }

  .site-nav-name {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-heading);
    text-decoration: none;
  }

  .site-nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
  }

  .site-nav-link {
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
  }

  .site-nav-link:hover {
    color: var(--color-heading);
  }

  .site-nav-link.active {
    color: var(--color-heading);
    border-bottom-color: var(--color-heading);
  }
</style>
