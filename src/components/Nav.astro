---
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const links = [
  { href: "/", label: "Profile", active: pathname === "/" },
  {
    href: "/work",
    label: "Projects",
    active: pathname.startsWith("/work"),
  },
  {
    href: "/certifications",
    label: "Certifications",
    active: pathname.startsWith("/certifications"),
  },
  {
    href: "/resume",
    label: "Resume",
    active: pathname.startsWith("/resume"),
  },
] as const;
---

<header class="site-nav">
  <div class="container site-nav-inner">
    <a class="site-nav-mark" href="/" aria-label="Rehan Ghias — home">RG</a>
    <nav class="site-nav-links" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={["meta", "site-nav-link", { active: link.active }]}
            aria-current={link.active ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .site-nav-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .site-nav-mark {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-heading);
    text-decoration: none;
  }

  .site-nav-mark:hover {
    color: var(--color-accent);
  }

  .site-nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
  }

  .site-nav-link {
    text-decoration: none;
    color: var(--color-muted);
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
  }

  .site-nav-link:hover {
    color: var(--color-accent);
  }

  .site-nav-link.active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
</style>
