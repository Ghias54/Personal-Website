---
import Figure from "./Figure.astro";
import { splitFigures } from "../lib/processMarkdownHtml";
import { getPublicImageSize } from "../lib/imageSize";
import { titleCaseH3 } from "../lib/titleCase";

interface Props {
  html: string;
}

const { html } = Astro.props;
const segments = splitFigures(html);
---

<div class="prose">
  {
    segments.map((segment) => {
      if (segment.type === "html") {
        return <Fragment set:html={titleCaseH3(segment.content)} />;
      }

      const dims = segment.src ? getPublicImageSize(segment.src) : undefined;

      return (
        <Figure
          description={segment.description}
          caption={segment.caption}
          src={segment.src}
          alt={segment.alt}
          width={dims?.width}
          height={dims?.height}
        />
      );
    })
  }
</div>
