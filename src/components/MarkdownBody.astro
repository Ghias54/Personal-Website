---
import Figure from "./Figure.astro";
import { splitFigures } from "../lib/processMarkdownHtml";

interface Props {
  html: string;
}

const { html } = Astro.props;
const segments = splitFigures(html);
---

<div class="prose">
  {
    segments.map((segment) =>
      segment.type === "html" ? (
        <Fragment set:html={segment.content} />
      ) : (
        <Figure description={segment.description} caption={segment.caption} />
      ),
    )
  }
</div>
