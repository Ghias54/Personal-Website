---
interface Props {
  description: string;
  caption: string;
  /** When set, renders a real image instead of the placeholder. */
  src?: string;
  alt?: string;
}

const { description, caption, src, alt = description } = Astro.props;
---

<figure class="figure">
  {
    src ? (
      <img class="figure-image" src={src} alt={alt} />
    ) : (
      <div class="figure-placeholder" role="img" aria-label={description}>
        <span class="meta">{description}</span>
      </div>
    )
  }
  <figcaption class="meta">{caption}</figcaption>
</figure>

<style>
  .figure {
    margin: 0;
  }

  .figure-placeholder,
  .figure-image {
    display: block;
    width: 100%;
    height: 150px;
    border: 0.5px dashed var(--color-border);
    background: var(--color-figure);
  }

  .figure-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    text-align: center;
  }

  .figure-placeholder .meta {
    text-transform: none;
    letter-spacing: 0.02em;
    font-weight: 500;
  }

  .figure-image {
    object-fit: cover;
  }

  figcaption {
    margin-top: 0.6em;
  }
</style>
