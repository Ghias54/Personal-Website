---
/**
 * GitHub contribution heat map for one calendar year, fetched at BUILD time from
 * the GitHub GraphQL API and rendered as static SVG (no client-side JS).
 *
 * Needs a GITHUB_TOKEN build variable. If the token is missing or the request
 * fails, the component renders nothing so the build never breaks.
 */
interface Props {
  username: string;
  year?: number;
}

const { username, year = 2026 } = Astro.props;
const token = import.meta.env.GITHUB_TOKEN ?? process.env.GITHUB_TOKEN;

type Day = { date: string; contributionCount: number; contributionLevel: string };
type Week = { contributionDays: Day[] };

// Calendar year, but never ask for days that haven't happened yet
const from = new Date(Date.UTC(year, 0, 1));
const yearEnd = new Date(Date.UTC(year, 11, 31, 23, 59, 59));
const now = new Date();
const to = now < yearEnd ? now : yearEnd;

let weeks: Week[] = [];
let total = 0;

if (token) {
  try {
    const res = await fetch("https://api.github.com/graphql", {
      method: "POST",
      headers: {
        Authorization: `bearer ${token}`,
        "Content-Type": "application/json",
        "User-Agent": "rehanghias.com-build",
      },
      body: JSON.stringify({
        query: `query($login: String!, $from: DateTime!, $to: DateTime!) {
          user(login: $login) {
            contributionsCollection(from: $from, to: $to) {
              contributionCalendar {
                totalContributions
                weeks { contributionDays { date contributionCount contributionLevel } }
              }
            }
          }
        }`,
        variables: { login: username, from: from.toISOString(), to: to.toISOString() },
      }),
    });
    const json = await res.json();
    const cal = json?.data?.user?.contributionsCollection?.contributionCalendar;
    if (cal) {
      weeks = cal.weeks;
      total = cal.totalContributions;
    } else {
      console.warn("[GitHubHeatmap] No calendar in response:", JSON.stringify(json?.errors ?? json));
    }
  } catch (err) {
    console.warn("[GitHubHeatmap] Fetch failed:", err);
  }
} else {
  console.warn("[GitHubHeatmap] GITHUB_TOKEN not set; skipping heat map.");
}

// Pad the grid out to Dec 31 with empty future days so the year reads complete
const lastDate = weeks.at(-1)?.contributionDays.at(-1)?.date;
if (lastDate) {
  const d = new Date(lastDate + "T00:00:00Z");
  const end = new Date(Date.UTC(year, 11, 31));
  let week = weeks.at(-1)!;
  while (d < end) {
    d.setUTCDate(d.getUTCDate() + 1);
    if (d.getUTCDay() === 0) {
      week = { contributionDays: [] };
      weeks.push(week);
    }
    week.contributionDays.push({
      date: d.toISOString().slice(0, 10),
      contributionCount: -1,
      contributionLevel: "FUTURE",
    });
  }
}

const CELL = 11;
const GAP = 3;
const STEP = CELL + GAP;
const TOP = 18;
const LEFT = 28;

const levelClass: Record<string, string> = {
  NONE: "l0",
  FIRST_QUARTILE: "l1",
  SECOND_QUARTILE: "l2",
  THIRD_QUARTILE: "l3",
  FOURTH_QUARTILE: "l4",
  FUTURE: "lf",
};

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

// One label per month, placed at the week containing the 1st
const labels: { x: number; text: string }[] = [];
weeks.forEach((w, i) => {
  const firstOfMonth = w.contributionDays.find((d) => d.date.endsWith("-01"));
  if (firstOfMonth) {
    const m = Number(firstOfMonth.date.slice(5, 7)) - 1;
    labels.push({ x: LEFT + i * STEP, text: MONTHS[m] });
  }
});

const width = LEFT + weeks.length * STEP;
const height = TOP + 7 * STEP;

const fmt = (d: string) =>
  new Date(d + "T00:00:00Z").toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });
---

{
  weeks.length > 0 && (
    <figure class="heatmap">
      <div class="heatmap-scroll">
        <svg
          viewBox={`0 0 ${width} ${height}`}
          width={width}
          height={height}
          role="img"
          aria-label={`${total.toLocaleString("en-US")} GitHub contributions in ${year}`}
        >
          {labels.map((l) => (
            <text x={l.x} y={11} class="lbl">
              {l.text}
            </text>
          ))}
          <text x={0} y={TOP + 1 * STEP + 9} class="lbl">Mon</text>
          <text x={0} y={TOP + 3 * STEP + 9} class="lbl">Wed</text>
          <text x={0} y={TOP + 5 * STEP + 9} class="lbl">Fri</text>
          {weeks.map((w, wi) =>
            w.contributionDays.map((d) => {
              const dow = new Date(d.date + "T00:00:00Z").getUTCDay();
              return (
                <rect
                  x={LEFT + wi * STEP}
                  y={TOP + dow * STEP}
                  width={CELL}
                  height={CELL}
                  rx={2}
                  class={levelClass[d.contributionLevel] ?? "l0"}
                >
                  {d.contributionCount >= 0 && (
                    <title>
                      {d.contributionCount === 0 ? "No" : d.contributionCount} contribution
                      {d.contributionCount === 1 ? "" : "s"} on {fmt(d.date)}
                    </title>
                  )}
                </rect>
              );
            })
          )}
        </svg>
      </div>
      <figcaption>
        <span>
          <strong>{total.toLocaleString("en-US")}</strong> contributions in {year}, public and private
        </span>
        <span class="legend" aria-hidden="true">
          Less
          <i class="l0" />
          <i class="l1" />
          <i class="l2" />
          <i class="l3" />
          <i class="l4" />
          More
        </span>
      </figcaption>
    </figure>
  )
}

<style>
  .heatmap {
    margin: 0;
    max-width: 100%;
  }

  .heatmap-scroll {
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .heatmap svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }

  .lbl {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: var(--color-muted);
  }

  /* Navy scale matching the site header. Change these five to retheme. */
  .l0 { fill: #ebedf0; background: #ebedf0; }
  .l1 { fill: #b7c3d1; background: #b7c3d1; }
  .l2 { fill: #7d91a8; background: #7d91a8; }
  .l3 { fill: #46607d; background: #46607d; }
  .l4 { fill: #1f2a36; background: #1f2a36; }
  /* Days later in the year that haven't happened yet */
  .lf { fill: none; stroke: #e1e4ea; stroke-width: 1; }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 12px;
    font-size: var(--fs-body-sm);
    color: var(--color-dimmed);
  }

  figcaption strong {
    color: var(--color-text);
  }

  .legend {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--color-muted);
  }

  .legend i {
    display: inline-block;
    width: 11px;
    height: 11px;
    border-radius: 2px;
  }
</style>
