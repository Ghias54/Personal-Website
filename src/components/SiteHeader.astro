---
import Nav from "./Nav.astro";

interface Props {
  home?: boolean;
  title?: string;
  meta?: string;
}

const { home = false, title, meta } = Astro.props;
---

<header class="site-header">
  <div class="container">
    <Nav />
    <div class="header-body">
      {
        home ? (
          <>
            <h1 class="header-title home-title">Rehan A Ghias</h1>
            <p class="header-meta">Information Science & Economics · UIUC</p>
          </>
        ) : (
          <>
            <h1 class="header-title">{title}</h1>
            {meta && <p class="header-meta">{meta}</p>}
          </>
        )
      }
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  .site-header :global(.container) {
    background: transparent;
  }

  .header-body {
    padding: 46px 0 48px;
    background: transparent;
  }

  .header-title {
    margin: 0;
    color: var(--color-on-dark);
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: -0.03em;
    font-size: var(--fs-page-title);
    line-height: 1.15;
  }

  .home-title {
    font-size: clamp(32px, 6vw, 46px);
    letter-spacing: -0.03em;
    line-height: 1.1;
    white-space: nowrap;
  }

  .header-meta {
    margin: 16px 0 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-on-dark-muted);
    line-height: 1.5;
  }
</style>
