---
interface Props {
  label: string;
  id?: string;
}

const { label, id } = Astro.props;
---

<header class="section-header">
  <div class="section-rule" aria-hidden="true" />
  <h2 class="section-label" id={id}>{label}</h2>
</header>

<style>
  .section-header {
    margin: 48px 0 0;
    padding: 0;
  }

  .section-rule {
    height: 0;
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  .section-label {
    margin: 14px 0 20px;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-label);
    line-height: 1.4;
  }
</style>
