---
import { titleCase } from "../lib/titleCase";

interface Props {
  label: string;
  id?: string;
}

const { label, id } = Astro.props;
---

<header class="section-header">
  <h2 class="section-label" id={id}>{titleCase(label)}</h2>
</header>

<!-- Matches RailSection's heading so every section title on the site looks the same -->
<style>
  .section-header {
    margin: 64px 0 0;
    padding: 0;
  }

  .section-label {
    margin: 0 0 22px;
    padding-top: 22px;
    border-top: 2px solid var(--color-rule-strong);
    font-family: var(--font-sans);
    font-size: clamp(26px, 1.9vw, 34px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-heading);
  }

  @media (max-width: 700px) {
    .section-header {
      margin-top: 48px;
    }

    .section-label {
      margin-bottom: 16px;
      padding-top: 16px;
    }
  }
</style>
