---
import { titleCase } from "../lib/titleCase";

interface Props {
  label: string;
  as?: "section" | "div";
}

const { label: rawLabel, as: Tag = "section" } = Astro.props;
const label = titleCase(rawLabel);
// Anchor id comes from the original text so existing links keep working
const id = rawLabel
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "");
---

<Tag class="rail-section" id={id}>
  <h2 class="rail-label">
    <a class="rail-anchor" href={`#${id}`}>{label}</a>
  </h2>
  <div class="rail-content">
    <slot />
  </div>
</Tag>

<style>
  .rail-section {
    scroll-margin-top: 24px;
  }

  .rail-section + .rail-section {
    margin-top: 64px;
  }

  .rail-label {
    margin: 0 0 22px;
    padding-top: 22px;
    border-top: 2px solid var(--color-rule-strong);
    font-family: var(--font-sans);
    font-size: clamp(26px, 1.9vw, 34px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-heading);
    max-width: var(--measure);
  }

  .rail-anchor {
    color: inherit;
    text-decoration: none;
  }

  .rail-anchor:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-link-underline);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .rail-content {
    min-width: 0;
  }

  @media (max-width: 700px) {
    .rail-section + .rail-section {
      margin-top: 48px;
    }

    .rail-label {
      margin-bottom: 16px;
      padding-top: 16px;
    }
  }
</style>
