---
import BaseLayout from "./BaseLayout.astro";
import RailSection from "../components/RailSection.astro";
import MarkdownBody from "../components/MarkdownBody.astro";
import { splitCaseSections } from "../lib/processMarkdownHtml";

interface Props {
  title: string;
  description: string;
  meta: string;
  html: string;
}

const { title, description, meta, html } = Astro.props;
const sections = splitCaseSections(html);
---

<BaseLayout
  title={`${title} — Rehan Ghias`}
  description={description}
  bandTitle={title}
  bandMeta={meta}
>
  <main id="main-content" class="container page">
    {
      sections.map((section) =>
        section.label ? (
          <RailSection label={section.label}>
            <MarkdownBody html={section.html} />
          </RailSection>
        ) : (
          <MarkdownBody html={section.html} />
        ),
      )
    }
  </main>
</BaseLayout>
