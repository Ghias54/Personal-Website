---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";

// Flip to false once public/resume.pdf exists and the site is ready to be indexed.
const NOINDEX = false;

interface Props {
  title: string;
  description: string;
  homeBand?: boolean;
  bandTitle?: string;
  bandMeta?: string;
}

const { title, description, homeBand = false, bandTitle, bandMeta } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/og-image.png", Astro.site);
const siteName = "Rehan A Ghias";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {NOINDEX && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader home={homeBand} title={bandTitle} meta={bandMeta} />
    <slot />

    <dialog class="lightbox" aria-label="Full screen image">
      <button class="lightbox-close" type="button" aria-label="Close full screen image">×</button>
      <img class="lightbox-img" alt="" />
      <p class="lightbox-caption"></p>
    </dialog>

    <script>
      const dialog = document.querySelector<HTMLDialogElement>(".lightbox");
      const big = dialog?.querySelector<HTMLImageElement>(".lightbox-img");
      const cap = dialog?.querySelector<HTMLParagraphElement>(".lightbox-caption");
      const closeBtn = dialog?.querySelector<HTMLButtonElement>(".lightbox-close");

      if (dialog && big && cap && closeBtn) {
        const open = (img: HTMLImageElement) => {
          big.src = img.currentSrc || img.src;
          big.alt = img.alt;
          const figcap = img.closest("figure, .figure")?.querySelector("figcaption, .caption");
          cap.textContent = figcap?.textContent?.trim() ?? "";
          dialog.showModal();
        };

        document.querySelectorAll<HTMLImageElement>(".prose img, .figure img, figure img").forEach((img) => {
          if (img.closest(".lightbox")) return;
          img.classList.add("zoomable");
          img.tabIndex = 0;
          img.setAttribute("role", "button");
          img.setAttribute("aria-label", `View full screen: ${img.alt || "image"}`);
          img.addEventListener("click", () => open(img));
          img.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              open(img);
            }
          });
        });

        closeBtn.addEventListener("click", () => dialog.close());
        // Click anywhere outside the image closes it; Esc is handled by <dialog>
        dialog.addEventListener("click", (e) => {
          if (e.target !== big) dialog.close();
        });
        dialog.addEventListener("close", () => {
          big.removeAttribute("src");
        });
      }
    </script>
  </body>
</html>
